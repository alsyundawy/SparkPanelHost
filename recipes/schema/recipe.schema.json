{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherPanel v8.1 App Installer Recipe",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "description",
    "version",
    "upstream",
    "source",
    "requirements",
    "nginx_template",
    "waf_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "type": "string",
      "enum": [
        "cms",
        "forum",
        "marketplace",
        "webmail"
      ]
    },
    "description": {
      "type": "object",
      "required": [
        "id",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5
        },
        "en": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "upstream": {
      "type": "object",
      "required": [
        "provider"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "wordpress_org",
            "github_release"
          ]
        },
        "slug": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "asset_regex": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "strip_components"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "strip_components": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "php_min",
        "php_recommended",
        "php_extensions",
        "database",
        "disk_mb"
      ],
      "additionalProperties": false,
      "properties": {
        "php_min": {
          "type": "string",
          "enum": [
            "8.2",
            "8.3",
            "8.4",
            "8.5",
            "8.6"
          ]
        },
        "php_recommended": {
          "type": "string",
          "enum": [
            "8.3",
            "8.4",
            "8.5",
            "8.6"
          ]
        },
        "php_extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "database": {
          "type": "string",
          "enum": [
            "mariadb",
            "postgresql",
            "sqlite",
            "none"
          ]
        },
        "disk_mb": {
          "type": "integer",
          "minimum": 10
        }
      }
    },
    "nginx_template": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "waf_profile": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    }
  }
}
