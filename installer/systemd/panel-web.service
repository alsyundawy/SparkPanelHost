[Unit]
Description=SparkPanelHost v0.1.0 Unprivileged Control Plane API & Web UI
After=network.target panel-agent.service
Requires=panel-agent.service

[Service]
Type=simple
User=panel-web
Group=panel-web
ExecStart=/usr/local/bin/panel-web --config /etc/sparkpanel/config.yaml --listen :2087 --agent-socket /run/panel/agent.sock --db /var/panel/data/sparkpanel.db --migrations /usr/share/sparkpanel/migrations/001_init.sql --static /var/panel/web --recipes /var/panel/recipes
WorkingDirectory=/var/panel
UMask=0077
Restart=always
RestartSec=3s

# Strict Unprivileged Sandbox (Zero Capabilities)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/panel/data /var/panel/tmp /var/log/aetherpanel /var/log/sparkpanel
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
