  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "frontend/node_modules": true,
    "frontend/dist": true,
    "dist": true,
    "backend/gen": true,
